# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
/target
**/target
# SP1 guest ELFs produced by `make install-sp1-toolchain` builds (the tracked `rollup` / `mock_da` stubs stay)
/chain/provers/sp1/guest-*/elf/riscv32im-succinct-zkvm-elf
# Generated at build time by chain/stf/build.rs
.artifacts
/chain/stf/runtime_call.json
/chain/stf/autogenerated.inc.rs
**/rustc-ice-*.txt

# ---------------------------------------------------------------------------
# Chain data (created by the node; `make clean-db` deletes it)
# ---------------------------------------------------------------------------
/rollup-state/
**/mock_da.sqlite*
**/rollup-starter-data*
**/selendra-data*
/testing/test-data/docker

# ---------------------------------------------------------------------------
# JavaScript clients
# ---------------------------------------------------------------------------
**/node_modules
**/dist
/clients/starter-js/src/types.ts
/clients/evm-ethers/artifacts
/clients/evm-ethers/deployments

# ---------------------------------------------------------------------------
# Local infrastructure / testing
# ---------------------------------------------------------------------------
# Cloned by scripts/start_observability.sh
/devnet/observability
# Acceptance / soak test output
/testing/acceptance-test/acceptance-test-data*
/testing/acceptance-test/acceptance-throughput/*
/testing/acceptance-test/rollup-manager-build/*
/testing/acceptance-test/rollup-build-cache/*
# Scripts generated from the docs by CI (bashtestmd)
/scripts/rollup-starter*.sh

# ---------------------------------------------------------------------------
# Keys and local tooling
# ---------------------------------------------------------------------------
# Never commit real keys. (devnet/credentials/* and testing/test-data/keys/* are public test keys and ARE tracked.)
.keys
*.pem
.idea
.claude
