.PHONY: help check lint install-risc0-toolchain install-sp1-toolchain clean clean-db build-docker-mock-da run-docker-mock-da stop-docker-mock-da start-obs stop-obs start-celestia stop-celestia print-hyperlane-ethtest-warp

# Should remain at the top, otherwise `make` won't print help
help: ## Display this help message
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

check: ## Run cargo check here and in for all ZKVM Provers. Useful for updating Cargo.lock
	SKIP_GUEST_BUILD=1 cargo check
	SKIP_GUEST_BUILD=1 cargo check --manifest-path chain/provers/risc0/guest-celestia/Cargo.toml
	SKIP_GUEST_BUILD=1 cargo check --manifest-path chain/provers/risc0/guest-mock/Cargo.toml
	SKIP_GUEST_BUILD=1 cargo check --manifest-path chain/provers/sp1/guest-celestia/Cargo.toml
	SKIP_GUEST_BUILD=1 cargo check --manifest-path chain/provers/sp1/guest-mock/Cargo.toml

lint: ## Run fmt, check and clippy with the most important feature combinations
	SKIP_GUEST_BUILD=1 cargo fmt --all -- --check
	SKIP_GUEST_BUILD=1 cargo check --workspace
	SKIP_GUEST_BUILD=1 cargo check --features celestia_da --features risc0 --no-default-features
	SKIP_GUEST_BUILD=1 cargo check --features celestia_da --features sp1 --no-default-features
	SKIP_GUEST_BUILD=1 cargo check --features celestia_da --features mock_zkvm --no-default-features
	SKIP_GUEST_BUILD=1 cargo check --manifest-path testing/acceptance-test/Cargo.toml
	SKIP_GUEST_BUILD=1 cargo check --manifest-path testing/soak-test/Cargo.toml
	SKIP_GUEST_BUILD=1 cargo clippy --workspace
	SKIP_GUEST_BUILD=1 cargo clippy --features celestia_da --features risc0 --no-default-features
	SKIP_GUEST_BUILD=1 cargo clippy --features celestia_da --features sp1 --no-default-features
	SKIP_GUEST_BUILD=1 cargo clippy --features celestia_da --features mock_zkvm --no-default-features
	SKIP_GUEST_BUILD=1 cargo clippy --manifest-path testing/acceptance-test/Cargo.toml
	SKIP_GUEST_BUILD=1 cargo clippy --manifest-path testing/soak-test/Cargo.toml
	zepter  # Run it several times, as fix from the first run can uncover other issues
	zepter
	zepter

install-risc0-toolchain: ## Install correct version of RISC0 toolchain
	curl -L https://risczero.com/install | bash
	~/.risc0/bin/rzup install cargo-risczero 3.0.5
	~/.risc0/bin/rzup install r0vm 3.0.5
	~/.risc0/bin/rzup install rust 1.91.1
	~/.risc0/bin/rzup install cpp 2024.1.5
	@echo "Risc0 toolchain version:"
	cargo +risc0 --version


install-sp1-toolchain: ## Install correct version of SP1 toolchain
	curl -L https://sp1up.succinct.xyz | bash
	~/.sp1/bin/sp1up $${GITHUB_TOKEN:+--token "$$GITHUB_TOKEN"} --version 6.2.2
	~/.sp1/bin/cargo-prove prove --version
	~/.sp1/bin/cargo-prove prove install-toolchain
	@echo "SP1 toolchain version:"
	rustc +succinct --version

clean: clean-db
clean: ## Clean all builds and artifacts and databases
	@cargo clean
	@cargo clean --manifest-path chain/provers/risc0/guest-celestia/Cargo.toml
	@cargo clean --manifest-path chain/provers/risc0/guest-mock/Cargo.toml
	@cargo clean --manifest-path chain/provers/sp1/guest-celestia/Cargo.toml
	@cargo clean --manifest-path chain/provers/sp1/guest-mock/Cargo.toml
	@cargo clean --manifest-path testing/acceptance-test/Cargo.toml
	@cargo clean --manifest-path testing/soak-test/Cargo.toml
	rm -rf clients/starter-js/node_modules
	rm -rf clients/privy/node_modules
	rm -f chain/stf/runtime_call.json
	rm -f chain/stf/autogenerated.inc.rs
	rm -f clients/starter-js/src/types.ts
	$(MAKE) -C devnet clean

clean-db: ## Clean all databases
	rm -rf rollup-state/selendra-data-mock
	rm -rf rollup-state/selendra-data-celestia
	rm -rf rollup-state/selendra-data-external
	rm -rf rollup-state/mock_da.sqlite
	rm -rf testing/test-data/docker

# Add `--build-arg BUILD_MODE=release` for release builds
build-docker-mock-da: ## Build docker container for the rollup with MockDa
	DOCKER_BUILDKIT=1 \
	docker build \
	--load \
	-f ./devnet/rollup/Dockerfile.mock \
	-t rollup-starter:debug \
	.

run-docker-mock-da: ## Start docker container with MockDa
	mkdir -p testing/test-data/docker
	mkdir -p testing/test-data/docker/da
	mkdir -p testing/test-data/docker/state
	@if [ "$(BACKGROUND)" = "true" ]; then \
		docker run -d \
			--name rollup-mock-da \
			--privileged \
			-v $(CURDIR)/testing/test-data/docker/da:/mnt/da \
			-v $(CURDIR)/testing/test-data/docker/state:/mnt/state \
			-p 12346:12346 \
			rollup-starter:debug; \
	else \
		docker run -it \
			--privileged \
			-v $(CURDIR)/testing/test-data/docker/da:/mnt/da \
			-v $(CURDIR)/testing/test-data/docker/state:/mnt/state \
			-p 12346:12346 \
			rollup-starter:debug; \
	fi

stop-docker-mock-da: ## Stop docker container with MockDa
	@docker stop rollup-mock-da 2>/dev/null || true
	@docker rm rollup-mock-da 2>/dev/null || true

start-obs:  ## Start observability stack
	./scripts/start_observability.sh

stop-obs:  ## Stop observability stack
	./scripts/stop_observability.sh

start-celestia: ## Start Celestia docker compose
	$(MAKE) -C devnet start-celestia

stop-celestia: ## Stop Celestia docker compose
	$(MAKE) -C devnet stop-celestia

start-hyperlane-ethtest: ## Start Hyperlane ethtest docker compose
	$(MAKE) -C devnet start-hyperlane-ethtest

stop-hyperlane-ethtest: ## Stop Hyperlane ethtest docker compose
	$(MAKE) -C devnet stop-hyperlane-ethtest

print-hyperlane-ethtest-warp:
	@cd devnet/hyperlane && docker compose -f docker-compose.hyp-evm.yml run --rm \
		hyperlane-cli \
		warp read \
		--registry /configs \
		--chain ethtest \
		--address $(shell grep "addressOrDenom:" devnet/hyperlane/configs/deployments/warp_routes/ETH/warp-route-deployment-config.yaml | cut -d'"' -f2)

# ---------------------------------------------------------------------------
# Selendra local testnet shortcuts (see docs/LocalSelendra.md)
# ---------------------------------------------------------------------------
.PHONY: selendra-mock selendra-celestia selendra-tx selendra-value selendra-transfer selendra-explorer selendra-evm-demo selendra-evm-deploy selendra-evm-watch selendra-evm-compat

selendra-mock: ## Run Selendra on the local mock DA (no Docker needed)
	cargo run -- --rollup-config-path=configs/mock/rollup.toml --genesis-path=configs/mock/genesis.json

selendra-celestia: ## Run Selendra on the local Celestia devnet (run `make start-celestia` first)
	cargo run --no-default-features --features=celestia_da,mock_zkvm -- --rollup-config-path=configs/celestia/rollup.toml --genesis-path=configs/celestia/genesis.json

selendra-tx: ## Send a test "create token" transaction to the running node
	cd clients/starter-js && npm install --silent && npm run start

selendra-value: ## Read the value-setter module state from the running node
	@curl -s http://127.0.0.1:12346/modules/value-setter/state/value; echo

selendra-transfer: ## Send SEL: make selendra-transfer TO=0x... AMOUNT=1.5 [TOKEN=token_...]
	cd clients/starter-js && npm install --silent && npm run --silent transfer -- $(TO) $(AMOUNT) $(TOKEN)

selendra-explorer: ## Serve the block explorer at http://127.0.0.1:8080 (node must be running)
	python3 -m http.server 8080 --bind 127.0.0.1 --directory explorer

selendra-evm-demo: ## EVM walkthrough with ethers.js: deploy an ERC-20, call it, read events, send SEL
	cd clients/evm-ethers && npm install --silent && npm run --silent demo

selendra-evm-deploy: ## Deploy a contract from clients/evm-ethers/contracts: make selendra-evm-deploy [CONTRACT=SelendraToken] [ARGS='"Name" SYM 1000']
	cd clients/evm-ethers && npm install --silent && npm run --silent deploy -- $(or $(CONTRACT),SelendraToken) $(ARGS)

selendra-evm-watch: ## Stream new blocks (and Transfer events of TOKEN=0x...) over WebSocket
	cd clients/evm-ethers && npm install --silent && npm run --silent watch -- $(TOKEN)

selendra-evm-compat: ## EVM compatibility suite: RPC methods, tx types, opcodes, precompiles, contracts, errors, logs, limits
	cd clients/evm-ethers && npm install --silent && npm run --silent compat
